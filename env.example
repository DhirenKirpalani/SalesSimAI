# Supabase Project URL and Anon Key
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side ONLY, never expose to browser (no NEXT_PUBLIC_ prefix)
# Required for API routes that bypass RLS (e.g. heygen-test scenario lookup)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Pre-created LLM config for /heygen-test page — reused across sessions to skip ~2s creation step
# On first run without this set, the created ID will be logged — copy it here
LIVEAVATAR_TEST_LLM_CONFIG_ID=

# OpenAI — used by buyer brain, coaching, and RAG embedding
OPENAI_API_KEY=sk-...

# ElevenLabs — used for voice-turn TTS fallback
ELEVENLABS_API_KEY=...

# ElevenLabs Conversational AI (new voice layer)
# Agent ID from the ElevenLabs dashboard. Public so the browser SDK can start the session.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_...

# Granola — server-side API key for importing meeting notes
# Create at https://docs.granola.ai/introduction (starts with grn_)
GRANOLA_API_KEY=grn_...
