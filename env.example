# Supabase Project URL and Anon Key
# Find these in your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side ONLY, never expose to browser (no NEXT_PUBLIC_ prefix)
# Required for API routes that bypass RLS (e.g. heygen-test scenario lookup)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Pre-created LLM config for /heygen-test page — reused across sessions to skip ~2s creation step
# On first run without this set, the created ID will be logged — copy it here
LIVEAVATAR_TEST_LLM_CONFIG_ID=
